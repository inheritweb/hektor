{
  "name": "@hektor/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "dev": "dotenv -e ../../.env -- next dev --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "start": "dotenv -e ../../.env -- next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hektor/types": "workspace:*",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hektor/eslint-config": "workspace:*",
    "@hektor/typescript-config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.0",
    "dotenv-cli": "11.0.0",
    "eslint": "^9.39.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
