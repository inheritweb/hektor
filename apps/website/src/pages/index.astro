---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Logo } from '@hektor/ui-astro';
---

<BaseLayout title="Hektor — Coming soon">
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <Logo size="xl" />
    <p class="max-w-md text-lg text-muted-foreground">
      We're building something new. Our website is coming soon.
    </p>
  </main>
</BaseLayout>
