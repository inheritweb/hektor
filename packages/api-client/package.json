{
  "name": "@hektor/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./system": {
      "types": "./src/system.ts",
      "import": "./src/system.ts"
    },
    "./users": {
      "types": "./src/users.ts",
      "import": "./src/users.ts"
    },
    "./organisations": {
      "types": "./src/organisations.ts",
      "import": "./src/organisations.ts"
    },
    "./patient-profiles": {
      "types": "./src/patient-profiles.ts",
      "import": "./src/patient-profiles.ts"
    },
    "./patient-scenarios": {
      "types": "./src/patient-scenarios.ts",
      "import": "./src/patient-scenarios.ts"
    },
    "./statistics": {
      "types": "./src/statistics.ts",
      "import": "./src/statistics.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hektor/types": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hektor/eslint-config": "workspace:*",
    "@hektor/typescript-config": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
