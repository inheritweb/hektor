{
  "name": "@hektor/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./system": {
      "types": "./src/system/index.ts",
      "import": "./src/system/index.ts"
    },
    "./users": {
      "types": "./src/users/index.ts",
      "import": "./src/users/index.ts"
    },
    "./organisations": {
      "types": "./src/organisations/index.ts",
      "import": "./src/organisations/index.ts"
    },
    "./patient-profiles": {
      "types": "./src/patient-profiles/index.ts",
      "import": "./src/patient-profiles/index.ts"
    },
    "./patient-scenarios": {
      "types": "./src/patient-scenarios/index.ts",
      "import": "./src/patient-scenarios/index.ts"
    },
    "./simulator": {
      "types": "./src/simulator/index.ts",
      "import": "./src/simulator/index.ts"
    },
    "./statistics": {
      "types": "./src/statistics/index.ts",
      "import": "./src/statistics/index.ts"
    },
    "./scim": {
      "types": "./src/scim/index.ts",
      "import": "./src/scim/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hektor/messaging": "workspace:*",
    "@hektor/types": "workspace:*",
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "@hektor/eslint-config": "workspace:*",
    "@hektor/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
