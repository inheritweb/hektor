{
  "name": "@hektor/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./database": {
      "types": "./src/database.ts"
    },
    "./system": {
      "types": "./src/system.ts",
      "import": "./src/system.ts"
    },
    "./statistics": {
      "types": "./src/statistics.ts",
      "import": "./src/statistics.ts"
    },
    "./contracts/system": {
      "types": "./src/contracts/system.ts",
      "import": "./src/contracts/system.ts"
    },
    "./contracts": {
      "types": "./src/contracts/base.ts",
      "import": "./src/contracts/base.ts"
    },
    "./contracts/organisations": {
      "types": "./src/contracts/organisations.ts",
      "import": "./src/contracts/organisations.ts"
    },
    "./contracts/patient-profiles": {
      "types": "./src/contracts/patient-profiles.ts",
      "import": "./src/contracts/patient-profiles.ts"
    },
    "./contracts/statistics": {
      "types": "./src/contracts/statistics.ts",
      "import": "./src/contracts/statistics.ts"
    },
    "./contracts/users": {
      "types": "./src/contracts/users.ts",
      "import": "./src/contracts/users.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hektor/eslint-config": "workspace:*",
    "@hektor/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
