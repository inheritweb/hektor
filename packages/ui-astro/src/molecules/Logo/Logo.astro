---
import LogoMark from './LogoMark.astro';

interface Props {
  class?: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'mark' | 'lockup';
}

const {
  class: className,
  label = 'Hektor',
  size = 'md',
  variant = 'lockup',
} = Astro.props;

const sizeGap: Record<NonNullable<Props['size']>, string> = {
  sm: 'gap-2 text-lg',
  md: 'gap-2.5 text-2xl',
  lg: 'gap-3 text-3xl',
  xl: 'gap-3.5 text-4xl',
};

const markSize: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-6 w-[1.44rem]',
  md: 'h-8 w-[1.92rem]',
  lg: 'h-10 w-9',
  xl: 'h-12 w-[2.88rem]',
};
---

<span
  aria-label={label}
  role="img"
  class:list={['inline-flex items-center text-title', sizeGap[size], className]}
>
  <LogoMark class:list={['shrink-0 text-primary', markSize[size]]} />
  {
    variant === 'lockup' ? (
      <span class="font-title font-black tracking-[-0.045em]">{label}</span>
    ) : null
  }
</span>
