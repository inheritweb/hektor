{
  "name": "@hektor/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#atoms/*": "./src/atoms/*",
    "#components/*": "./src/*",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./atoms": {
      "types": "./src/atoms/index.ts",
      "import": "./src/atoms/index.ts"
    },
    "./context": {
      "types": "./src/context/index.ts",
      "import": "./src/context/index.ts"
    },
    "./molecules": {
      "types": "./src/molecules/index.ts",
      "import": "./src/molecules/index.ts"
    },
    "./organisms": {
      "types": "./src/organisms/index.ts",
      "import": "./src/organisms/index.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "import": "./src/templates/index.ts"
    },
    "./pages": {
      "types": "./src/pages/index.ts",
      "import": "./src/pages/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "storybook": "storybook dev --port 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hektor/brand": "workspace:*",
    "@hektor/tailwind-config": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react-icons": "5.5.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@hektor/eslint-config": "workspace:*",
    "@hektor/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
